{
  "version": 2,
  "builds": [
    {
      "src": "api/line_webhook.js",
      "use": "@vercel/node"
    },
    {
      "src": "!(api)/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/line_webhook",
      "dest": "/api/line_webhook.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
